# SentinelASM stack configuration.
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_hex(32))"  # → paste as JWT_SECRET

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=sentinelasm
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass

# ── Backend (FastAPI) ─────────────────────────────────────────────────────
# Service-to-service URLs inside the compose network.
DATABASE_URL=postgresql://sentinel:sentinelpass@postgres:5432/sentinelasm
REDIS_URL=redis://redis:6379/0

# REQUIRED in every environment — startup refuses to boot without one.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=SentinelASM
ENVIRONMENT=production
DEBUG=False

# Comma-separated origins allowed to call the API (the reverse proxy serves
# the SPA, so this is the public origin, not the internal frontend service).
CORS_ORIGINS=http://localhost,http://localhost:80

# ── SMTP (password resets + digest emails; optional) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelasm@example.com

# Public origin used in password-reset links.
FRONTEND_URL=http://localhost

# ── CVE enrichment (OSV.dev) ────────────────────────────────────────────
OSV_API_URL=https://api.osv.dev/v1/query
OSV_TIMEOUT_SECONDS=10.0
OSV_ENABLED=True

# ── Reverse proxy ─────────────────────────────────────────────────────────
# Public host used for the TLS server_name and cert paths. Only needed when
# terminating TLS at nginx (see nginx/nginx.conf).
SERVER_NAME=app.example.com
HTTP_PORT=80
HTTPS_PORT=443
