# SentinelASM stack configuration (docker compose runtime).
# Copy to .env and fill in real values. NEVER commit .env.
#
#   make setup        # idempotent: creates .env only if missing, with secrets
#   # ...or manually:
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_hex(32))"  # → paste as JWT_SECRET
#
# Local `uvicorn` development (outside compose) uses backend/.env instead --
# see backend/.env.example. The two files share every variable's meaning;
# only hostnames differ (service names here vs localhost there).

# ── Postgres (compose service) ──────────────────────────────────────────
# Credentials for the compose `postgres` service. POSTGRES_PASSWORD is
# generated by scripts/bootstrap.sh; DATABASE_URL below must embed the same
# password (bootstrap keeps them in sync).
POSTGRES_DB=sentinelasm
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass

# ── Backend (FastAPI) ───────────────────────────────────────────────────
# Service-to-service URLs inside the compose network (`postgres` / `redis`
# are compose service names; local dev uses localhost -- see backend/.env).
DATABASE_URL=postgresql://sentinel:sentinelpass@postgres:5432/sentinelasm
# REDIS_URL doubles as Celery broker+backend, JWT blacklist, SSRF pins, rate limits.
REDIS_URL=redis://redis:6379/0

# REQUIRED in every environment — startup refuses to boot without one.
# 64-hex recommended: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-64-char-hex-secret
# Fernet key list for secrets at rest (alert integration credentials).
# REQUIRED in every environment. Comma-separated for rotation (first encrypts).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=change-me-generate-with-fernet
# Signing algorithm. Only HS256 is supported (auth/jwt.py).
JWT_ALGORITHM=HS256
# Access-token lifetime (minutes) and refresh-token lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=SentinelASM
# One of development|testing|production. Production rejects DEBUG=True and
# the default DATABASE_URL (app/core/config.py).
ENVIRONMENT=production
# Keep False in compose. Local dev may set True (see backend/.env.example).
DEBUG=False

# Comma-separated origins allowed to call the API. Behind the compose reverse
# proxy the SPA is served from the public origin, not the internal service.
CORS_ORIGINS=http://localhost,http://localhost:80

# ── SMTP (password resets + digest emails; optional) ────────────────────
# Empty SMTP_HOST disables sending (calls become no-ops returning False).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelasm@example.com

# Public origin used in password-reset links (the proxied SPA origin here;
# local dev uses http://localhost:5173 -- see backend/.env.example).
FRONTEND_URL=http://localhost

# ── Domain ownership verification (Phase 1) ─────────────────────────────
# Scans are allowed only for verified (or grace-grandfathered) domains.
# Turning this off disables all ownership enforcement: local development only.
REQUIRE_DOMAIN_VERIFICATION=True
# Days a verification stays valid before re-verification is required.
VERIFICATION_EXPIRY_DAYS=90
# Grace period (days) for migration-grandfathered domains.
VERIFICATION_GRACE_DAYS=14

# ── Alert webhooks (Phase 1) ────────────────────────────────────────────
# Comma-separated TCP ports that Slack/Discord/Jira webhook deliveries may
# target. Enforced at integration save time and at every send; changing it
# does not affect already-stored URLs until they are re-saved or re-sent.
WEBHOOK_ALLOWED_PORTS=443,8443

# ── CVE enrichment (OSV.dev) ────────────────────────────────────────────
# Banner-matched software versions are queried against OSV.dev. The feed
# hostname is resolved + SSRF-checked before every request.
OSV_API_URL=https://api.osv.dev/v1/query
OSV_TIMEOUT_SECONDS=10.0
# Set False to skip enrichment entirely (scans still complete).
OSV_ENABLED=True

# ── Rate limiting (requests per minute, Redis-backed) ─────────────────
# General API budget per client; auth and scan endpoints are stricter.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_SCAN_REQUESTS_PER_MINUTE=5

# ── KEV cache (CISA known-exploited-vulnerabilities enrichment) ───────
# Base directory for the local KEV cache. Empty falls back to /tmp.
KEV_CACHE_DIR=

# ── Logging ──────────────────────────────────────────────────────────
# One of DEBUG|INFO|WARNING|ERROR (applies to backend + worker + beat).
LOG_LEVEL=INFO
# json for structured logs, anything else for plain text (utils/logger.py).
LOG_FORMAT=json

# ── Reverse proxy ───────────────────────────────────────────────────────
# Public host used for the TLS server_name and cert paths. Only needed when
# terminating TLS at nginx (see nginx/nginx.conf).
SERVER_NAME=app.example.com
HTTP_PORT=80
HTTPS_PORT=443
