# SentinelASM backend configuration (LOCAL `uvicorn` development).
# Copy to .env and fill in real values. NEVER commit .env.
#
#   make setup        # idempotent: creates backend/.env only if missing
#   # ...or manually:
#   cp backend/.env.example backend/.env
#   python -c "import secrets; print(secrets.token_hex(32))"  # → paste as JWT_SECRET
#
# The docker compose stack uses the ROOT .env instead -- see .env.example.
# The two files share every variable's meaning; only hostnames differ
# (localhost here vs compose service names there).

APP_NAME=SentinelASM
# One of development|testing|production. Production rejects DEBUG=True and
# the default DATABASE_URL (app/core/config.py).
ENVIRONMENT=development
# Local dev default True: enables Celery eager mode (tasks run inline, no
# worker needed for quick iterations). Compose sets False and runs workers.
DEBUG=True

# PostgreSQL connection string (local server; compose uses @postgres host).
DATABASE_URL=postgresql://sentinel:sentinelpass@localhost:5432/sentinelasm

# Redis: Celery broker+backend, JWT blacklist/refresh store, SSRF pins,
# rate-limit storage (local server; compose uses redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# JWT signing secret - REQUIRED in every environment (startup fails without it).
# 64-hex recommended:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-64-char-hex-secret

# Signing algorithm. Only HS256 is supported (auth/jwt.py).
JWT_ALGORITHM=HS256
# Access-token lifetime (minutes) and refresh-token lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated origins allowed to call the API. Unset here: the app default
# (app/core/config.py) allows the Vite dev server http://localhost:5173.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP for password reset / digest emails (optional in dev).
# Empty SMTP_HOST disables sending (calls become no-ops returning False).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelasm@example.com

# Frontend origin used in password reset links (Vite dev server here;
# compose uses the proxied http://localhost -- see root .env.example).
FRONTEND_URL=http://localhost:5173

# CVE enrichment (OSV.dev) — matched against banner-grabbed software versions.
# The feed hostname is resolved + SSRF-checked before every request.
OSV_API_URL=https://api.osv.dev/v1/query
OSV_TIMEOUT_SECONDS=10.0
# Set False to skip enrichment entirely (scans still complete).
OSV_ENABLED=True
