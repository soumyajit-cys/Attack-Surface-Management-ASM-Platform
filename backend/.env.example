# SentinelASM backend configuration
# Copy to .env and fill in real values. NEVER commit .env.

APP_NAME=SentinelASM
DEBUG=True

# PostgreSQL connection string
DATABASE_URL=postgresql://sentinel:sentinelpass@localhost:5432/sentinelasm

# Redis (broker + token blacklist/refresh store)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret - REQUIRED in every environment (startup fails without it).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-64-char-hex-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP for password reset / digest emails (optional in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelasm@example.com

# Frontend origin used in password reset links
FRONTEND_URL=http://localhost:5173